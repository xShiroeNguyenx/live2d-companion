{
  "name": "live2d-companion-studio",
  "version": "0.1.0",
  "description": "GUI editor for existing Live2D Cubism models — edit motion, physics, expressions, outfits and textures without code",
  "main": "./out/main/index.js",
  "author": "NguyenKhanh",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "npm run sync:core && npm run build:framework-types",
    "sync:core": "node scripts/sync-core.js",
    "dev": "npm run sync:core && electron-vite dev",
    "build": "npm run sync:core && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.vendor.json",
    "build:framework-types": "tsc -p vendor/cubism-web-framework/tsconfig.emit.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.js",
    "ui:shots": "node scripts/ui-shots.js",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "dev:detached": "node scripts/launch-detached.js",
    "dev:stop": "node scripts/stop-detached.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "immer": "^10.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^3.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "zustand": "^5.0.8"
  }
}
